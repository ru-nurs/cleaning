DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_cleaning?schema=public"
PORT=4000
CORS_ORIGIN="*"
NODE_ENV="development"
ENABLE_DEMO_LOGIN="true"
SESSION_TTL_DAYS=30
MAX_PROOF_BYTES=10485760
REQUEST_BODY_LIMIT_BYTES=26214400
PAYOUT_RATIO=0.72
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-sol"
OPENAI_TIMEOUT_MS=45000

# Production requirements:
# - set NODE_ENV="production"
# - set ENABLE_DEMO_LOGIN="false"
# - replace CORS_ORIGIN="*" with the exact allowed origin
# - create a new OPENAI_API_KEY and store it only in the hosting provider's secret environment
